{
  "managedApiConnections": {},
  "serviceProviderConnections": {
    "AzureBlob": {
      "displayName": "azure-blob",
      "parameterValues": {
        "connectionString": "@appsetting('AZURE_STORAGE_CONNECTION_STRING')"
      },
      "serviceProvider": {
        "id": "/serviceProviders/AzureBlob"
      }
    },
    "openai": {
      "displayName": "azure-openai",
      "parameterValues": {
        "openAIEndpoint": "@appsetting('AZURE_OPENAI_ENDPOINT')"
      },
      "serviceProvider": {
        "id": "/serviceProviders/openai"
      }
    },
    "servicebus": {
      "displayName": "service-bus",
      "parameterValues": {
        "fullyQualifiedNamespace": "@appsetting('SERVICEBUS_NAMESPACE')"
      },
      "serviceProvider": {
        "id": "/serviceProviders/serviceBus"
      }
    }
  }
}
